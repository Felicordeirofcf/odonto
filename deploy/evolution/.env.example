# Copie para .env e troque os valores marcados com TROQUE.

# Domínio que aponta para o IP do VPS (registro A no seu DNS), ex.: whats.suaclinica.com.br
EVOLUTION_DOMAIN=TROQUE.seudominio.com.br
SERVER_URL=https://TROQUE.seudominio.com.br

# Senha da API (gere uma longa: openssl rand -hex 32). Vai também na Vercel como EVOLUTION_API_KEY.
AUTHENTICATION_API_KEY=TROQUE

# Banco de dados (a senha precisa ser igual nas duas linhas)
POSTGRES_PASSWORD=TROQUE
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:TROQUE@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution
DATABASE_SAVE_DATA_INSTANCE=true
# obrigatório: a IA lê o histórico da conversa a partir daqui
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=false

SERVER_TYPE=http
SERVER_PORT=8080
LANGUAGE=pt-BR
DEL_INSTANCE=false
LOG_LEVEL=ERROR,WARN,INFO
CONFIG_SESSION_PHONE_CLIENT=Clinica
CONFIG_SESSION_PHONE_NAME=Chrome
